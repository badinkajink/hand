+        fn = getattr(self.backend, "servo_diagnostics", None)
+        if fn is None:
+            raise RuntimeErrorState(f"the {self.backend.kind} backend has no servo diagnostics")
+        res = dict(fn(), servo_torque_commanded=commanded)
+        te = res.get("torque_enable") or {}
+        res["suspected_resets"] = sorted(sid for sid, v in te.items()
+                                         if v is not None and int(v) == TORQUE_UNSET and commanded == TORQUE_ON)
+        bad = res["suspected_resets"] or res.get("no_answer")
+        self._event("warning" if bad else "info", "servo diagnostics", res)
+        return res
