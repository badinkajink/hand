+    def servo_diagnostics(self) -> dict:
+        """One read of each servo's supply voltage, temperature, torque_enable and status byte, servo by servo: a
+        diagnosis on request, not telemetry (owner, 2026-11-16: "we dont need to poll this all the time, it's just a
+        useful diagnostic"). On 2026-11-16 the blind twists' nine servos all read torque 0 after a bus timeout mid-lift;
+        these fields tell a reboot (torque_enable at its power-on default 0), a sagging supply (voltage, as rustypot
+        returns it) and a servo's own latched fault (status) apart. A servo that does not answer one read is skipped
+        for the fields after it."""
+        reads = (("voltage", "read_present_voltage"), ("temperature", "read_present_temperature"),
+                 ("torque_enable", "read_torque_enable"), ("status", "read_status"))
+        ids = sorted(sid for joints in FINGER_JOINTS.values() for sid, _zero, _limits in joints.values())
+        out: dict = {"t": time.time()}
+        dead: set[int] = set()
+        for name, attr in reads:
+            fn = getattr(self.servos._c, attr, None)
+            if fn is None:
+                out[name] = None
+                continue
+            values: dict[int, float | None] = {}
+            for sid in ids:
+                if sid in dead:
+                    values[sid] = None
+                    continue
+                try:
+                    values[sid] = float(self.servos.servo(sid)._call(fn)[0])
+                except Exception:  # noqa: BLE001 - a servo that does not answer is the finding
+                    values[sid] = None
+                    dead.add(sid)
+            out[name] = values
+        out["no_answer"] = sorted(dead)
+        out["servo_bus"] = self.servos.health()
+        return out
+
