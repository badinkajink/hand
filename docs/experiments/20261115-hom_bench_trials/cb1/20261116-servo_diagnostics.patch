+    def servo_diagnostics(self) -> dict:
+        """The backend's one read of each servo (RealHardwareBackend.servo_diagnostics), logged as an event. Refused
+        during a policy stream, whose frames own the bus. suspected_resets: servos at torque_enable 0, the power-on
