<mujoco model="ur5_cb3">
  <!-- The lab's UR5 (CB3, PolyScope 3.15.8), drafted for cad_v3 on 2026-11-04 by
       logs/20261104-cad_v3/ur5/build_ur5_mjcf.py from ur_description's ur5.urdf (ros-industrial/universal_robot
       6507bb67, copy in rh56_controller/magpie_force_control/src/ur_description; the package declares a BSD licence).
       Kinematics: UR's nominal DH (d1 89.159, a2 -425, a3 -392.25, d4 109.15, d5 94.65, d6 82.3 mm); the controller's
       own calibration is not in it. Metres, radians. -->
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option integrator="implicitfast"/>

  <default>
    <default class="ur5">
      <material specular="0.4" shininess="0.3"/>
      <joint axis="0 0 1" range="-6.283185 6.283185" armature="0.1"/>
      <position ctrlrange="-6.283185 6.283185" kp="2000" kv="400" forcerange="-150 150"/>
      <default class="size3">
        <default class="size3_limited">
          <joint range="-3.141593 3.141593"/>
          <position ctrlrange="-3.141593 3.141593"/>
        </default>
      </default>
      <default class="size1">
        <position kp="500" kv="100" forcerange="-28 28"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" rgba="0.9 0.5 0.2 0.35"/>
      </default>
      <default class="frame">
        <site type="sphere" size="0.004" rgba="0.9 0.1 0.1 1" group="4"/>
      </default>
    </default>
  </default>

  <asset>
    <material name="Rohr" class="ur5" rgba="0.84 0.84 0.84 1"/>
    <material name="Scheibe" class="ur5" rgba="0.102 0.102 0.102 1"/>
    <material name="blau" class="ur5" rgba="0.502 0.695 0.819 1"/>
    <material name="verbindung" class="ur5" rgba="0.285 0.285 0.285 1"/>
    <material name="blau_005" class="ur5" rgba="0.401 0.556 0.655 1"/>
    <material name="verbindung_005" class="ur5" rgba="0.228 0.228 0.228 1"/>
    <material name="Rohr_005" class="ur5" rgba="0.672 0.672 0.672 1"/>
    <material name="blau_001" class="ur5" rgba="0.401 0.556 0.655 1"/>
    <material name="verbindung_001" class="ur5" rgba="0.228 0.228 0.228 1"/>
    <material name="Scheibe_001" class="ur5" rgba="0.0819 0.0819 0.0819 1"/>
    <material name="blau_002" class="ur5" rgba="0.401 0.556 0.655 1"/>
    <material name="verbindung_002" class="ur5" rgba="0.228 0.228 0.228 1"/>
    <material name="Scheibe_002" class="ur5" rgba="0.0819 0.0819 0.0819 1"/>
    <material name="Rohr_007_001" class="ur5" rgba="0.344 0.344 0.344 1"/>
    <material name="SWMaterial-1_004_002_001" class="ur5" rgba="0.159 0.165 0.174 1"/>
    <mesh name="base_0" file="visual/base_0.obj"/>
    <mesh name="base_1" file="visual/base_1.obj"/>
    <mesh name="shoulder_0" file="visual/shoulder_0.obj"/>
    <mesh name="shoulder_1" file="visual/shoulder_1.obj"/>
    <mesh name="shoulder_2" file="visual/shoulder_2.obj"/>
    <mesh name="upperarm_0" file="visual/upperarm_0.obj"/>
    <mesh name="upperarm_1" file="visual/upperarm_1.obj"/>
    <mesh name="upperarm_2" file="visual/upperarm_2.obj"/>
    <mesh name="upperarm_3" file="visual/upperarm_3.obj"/>
    <mesh name="forearm_0" file="visual/forearm_0.obj"/>
    <mesh name="forearm_1" file="visual/forearm_1.obj"/>
    <mesh name="forearm_2" file="visual/forearm_2.obj"/>
    <mesh name="wrist1_0" file="visual/wrist1_0.obj"/>
    <mesh name="wrist1_1" file="visual/wrist1_1.obj"/>
    <mesh name="wrist1_2" file="visual/wrist1_2.obj"/>
    <mesh name="wrist2_0" file="visual/wrist2_0.obj"/>
    <mesh name="wrist2_1" file="visual/wrist2_1.obj"/>
    <mesh name="wrist2_2" file="visual/wrist2_2.obj"/>
    <mesh name="wrist3_0" file="visual/wrist3_0.obj"/>
    <mesh name="wrist3_1" file="visual/wrist3_1.obj"/>
  </asset>

  <worldbody>
    <body name="base_link_inertia" childclass="ur5">
      <!-- the controller's Base frame B (URDF base_link_inertia = base = base_link turned by pi about z); z up -->
      <site name="base" class="frame"/>
      <site name="base_link" class="frame" quat="0 0 0 1"/>  <!-- ROS REP-103 base_link: x forward -->
      <inertial mass="4" pos="0 0 0" diaginertia="0.00443333156 0.00443333156 0.0072"/>
      <geom class="visual" mesh="base_0" material="Rohr" quat="0 0 0 1"/>
      <geom class="visual" mesh="base_1" material="Scheibe" quat="0 0 0 1"/>
      <geom name="base_disc" class="collision" type="cylinder" pos="0 0 0.011999" size="0.074095 0.012001"/>
      <geom name="base_cable_outlet" class="collision" type="box" pos="2e-05 0.092005 0.008554" size="0.005168 0.017995 0.005195"/>
      <body name="shoulder_link" pos="0 0 0.089159" gravcomp="1">
        <joint name="shoulder_pan_joint" class="size3"/>  <!-- URDF limit -360..360 deg, effort 150 N m, velocity 3.1416 rad/s -->
        <inertial mass="3.7" pos="0 0 0" diaginertia="0.0149723523 0.0149723523 0.01040625"/>
        <geom class="visual" mesh="shoulder_0" material="blau" quat="0 0 0 1"/>
        <geom class="visual" mesh="shoulder_1" material="verbindung" quat="0 0 0 1"/>
        <geom class="visual" mesh="shoulder_2" material="Scheibe" quat="0 0 0 1"/>
