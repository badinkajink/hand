        <geom name="shoulder_j2_side" class="collision" type="box" pos="5.8e-05 -0.035252 0.00163" size="0.059346 0.035249 0.06683"/>
        <body name="upper_arm_link" quat="0.707106781 0.707106781 0 0" gravcomp="1">
          <joint name="shoulder_lift_joint" class="size3"/>  <!-- URDF limit -360..360 deg, effort 150 N m, velocity 3.1416 rad/s -->
          <inertial mass="8.393" pos="-0.2125 0 0.136" quat="0.707106781 0 0.707106781 0" diaginertia="0.133885782 0.133885782 0.0151074"/>
          <geom class="visual" mesh="upperarm_0" material="blau" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5"/>
          <geom class="visual" mesh="upperarm_1" material="verbindung" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5"/>
          <geom class="visual" mesh="upperarm_2" material="Rohr" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5"/>
          <geom class="visual" mesh="upperarm_3" material="Scheibe" pos="0 0 0.13585" quat="0.5 0.5 -0.5 -0.5"/>
          <geom name="upperarm_j2" class="collision" type="cylinder" pos="0 0 0.137549" size="0.060491 0.066899"/>
          <geom name="upperarm_tube" class="collision" type="capsule" fromto="-0.425 9e-06 0.135717 0 9e-06 0.135717" size="0.052777"/>
          <geom name="upperarm_flare_j2" class="collision" type="cylinder" pos="-0.048759 1e-06 0.136114" quat="0.7071068 0 0.7071068 0" size="0.05888 0.031215"/>
          <geom name="upperarm_flare_j3" class="collision" type="cylinder" pos="-0.375935 -0.000129 0.135792" quat="0.7071068 0 0.7071068 0" size="0.059329 0.030928"/>
          <geom name="upperarm_j3" class="collision" type="cylinder" pos="-0.425 0 0.137518" size="0.0605 0.066868"/>
          <body name="forearm_link" pos="-0.425 0 0" gravcomp="1">
            <joint name="elbow_joint" class="size3_limited"/>  <!-- URDF limit -180..180 deg, effort 150 N m, velocity 3.1416 rad/s -->
            <inertial mass="2.275" pos="-0.196125 0 0.0165" quat="0.707106781 0 0.707106781 0" diaginertia="0.031216791 0.031216791 0.004095"/>
            <geom class="visual" mesh="forearm_0" material="blau_005" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5"/>
            <geom class="visual" mesh="forearm_1" material="verbindung_005" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5"/>
            <geom class="visual" mesh="forearm_2" material="Rohr_005" pos="0 0 0.0165" quat="0.5 0.5 -0.5 -0.5"/>
            <geom name="forearm_j3" class="collision" type="cylinder" pos="0 0 0.023928" size="0.059 0.047083"/>
            <geom name="forearm_tube" class="collision" type="capsule" fromto="-0.39225 -8.6e-05 0.016621 0 -8.6e-05 0.016621" size="0.038054"/>
            <geom name="forearm_flare_j3" class="collision" type="cylinder" pos="-0.060424 -4e-05 0.01714" quat="0.7071068 0 0.7071068 0" size="0.046837 0.019529"/>
            <geom name="forearm_flare_j4" class="collision" type="cylinder" pos="-0.362225 1.3e-05 0.016553" quat="0.7071068 0 0.7071068 0" size="0.037985 0.017221"/>
            <geom name="forearm_j4" class="collision" type="cylinder" pos="-0.39225 0 0.011662" size="0.039595 0.052338"/>
            <body name="wrist_1_link" pos="-0.39225 0 0.10915" gravcomp="1">
              <joint name="wrist_1_joint" class="size1"/>  <!-- URDF limit -360..360 deg, effort 28 N m, velocity 3.1416 rad/s -->
              <inertial mass="1.219" pos="0 0 0" diaginertia="0.00201388878 0.00201388878 0.0021942"/>
              <geom class="visual" mesh="wrist1_0" material="blau_001" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0"/>
              <geom class="visual" mesh="wrist1_1" material="verbindung_001" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0"/>
              <geom class="visual" mesh="wrist1_2" material="Scheibe_001" pos="0 0 -0.093" quat="0.707106781 0.707106781 0 0"/>
              <geom name="wrist1_j5_housing" class="collision" type="cylinder" pos="0 0.004838 0" quat="0.7071068 -0.7071068 0 0" size="0.0395 0.052338"/>
              <geom name="wrist1_j4_ring" class="collision" type="cylinder" pos="0 0 -0.003" size="0.037884 0.0425"/>
              <body name="wrist_2_link" pos="0 -0.09465 0" quat="0.707106781 0.707106781 0 0" gravcomp="1">
                <joint name="wrist_2_joint" class="size1"/>  <!-- URDF limit -360..360 deg, effort 28 N m, velocity 3.1416 rad/s -->
                <inertial mass="1.219" pos="0 0 0" diaginertia="0.00183103885 0.00183103885 0.0021942"/>
                <geom class="visual" mesh="wrist2_0" material="blau_002" pos="0 0 -0.095"/>
                <geom class="visual" mesh="wrist2_1" material="verbindung_002" pos="0 0 -0.095"/>
                <geom class="visual" mesh="wrist2_2" material="Scheibe_002" pos="0 0 -0.095"/>
                <geom name="wrist2_j6_housing" class="collision" type="cylinder" pos="0 -0.004844 0" quat="0.7071068 -0.7071068 0 0" size="0.039496 0.052344"/>
                <geom name="wrist2_j5_ring" class="collision" type="cylinder" pos="0 0 -0.022925" size="0.037979 0.022925"/>
                <body name="wrist_3_link" pos="0 0.0823 0" quat="0.707106781 -0.707106781 0 0" gravcomp="1">
                  <joint name="wrist_3_joint" class="size1"/>  <!-- URDF limit -360..360 deg, effort 28 N m, velocity 3.1416 rad/s -->
                  <inertial mass="0.1879" pos="0 0 -0.01525" diaginertia="8.06247261e-05 8.06247261e-05 0.000132117187"/>
                  <geom class="visual" mesh="wrist3_0" material="Rohr_007_001" pos="0 0 -0.0818" quat="0.707106781 0.707106781 0 0"/>
                  <geom class="visual" mesh="wrist3_1" material="SWMaterial-1_004_002_001" pos="0 0 -0.0818" quat="0.707106781 0.707106781 0 0"/>
                  <geom name="wrist3_flange" class="collision" type="cylinder" pos="0 0 -0.017225" size="0.038484 0.01725"/>
                  <geom name="wrist3_connector" class="collision" type="box" pos="-4e-06 -0.040726 -0.019699" size="0.003612 0.002274 0.003412"/>
                  <!-- tool0 = wrist_3_link: z out of the flange face (z 0); the visual mesh has the four M6 holes at +-45 and +-135 deg from x, no dowel hole, and the tool connector on -y -->
                  <site name="tool0" class="frame"/>
                  <body name="tool0">
                    <!-- attach an end effector here (mjSpec attach, or <attach> in XML) -->
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <!-- base_link_inertia is welded to the world, so MuJoCo's parent-child filter does not cover the shoulder's
         housing, which rests 0.04 mm into the base disc's top (z_B 24 mm) -->
    <exclude body1="base_link_inertia" body2="shoulder_link"/>
  </contact>

  <actuator>
    <position class="size3" name="shoulder_pan" joint="shoulder_pan_joint"/>
    <position class="size3" name="shoulder_lift" joint="shoulder_lift_joint"/>
    <position class="size3_limited" name="elbow" joint="elbow_joint"/>
    <position class="size1" name="wrist_1" joint="wrist_1_joint"/>
    <position class="size1" name="wrist_2" joint="wrist_2_joint"/>
    <position class="size1" name="wrist_3" joint="wrist_3_joint"/>
  </actuator>

  <keyframe>
    <!-- lab_home: the calibration cell's home, 2026-10-22 18:28 (flange along base -y);
         calib_home_v3id1: cell.json's tool registration (v3 ID 1 sphere pass 1, 2026-10-27);
         tool_down: the inverted rig's path over seat 1, 2026-11-02 14:20 (tool axis 3.8 deg from straight down);
         hand_down: computed by IK, not recorded: tool_down's flange x, y at z_B 400 mm, tool axis exactly -z_B -->
    <key name="lab_home" qpos="0.84288789 -1.5053337 1.9119157 -0.43316501 0.82633405 0.11221381" ctrl="0.84288789 -1.5053337 1.9119157 -0.43316501 0.82633405 0.11221381"/>
    <key name="calib_home_v3id1" qpos="1.038194 -1.3252234 2.0997128 -0.77868313 1.0839977 0.031856119" ctrl="1.038194 -1.3252234 2.0997128 -0.77868313 1.0839977 0.031856119"/>
    <key name="tool_down" qpos="0.87067881 -1.3188719 1.8023392 -2.0865111 -1.628087 -0.0012640166" ctrl="0.87067881 -1.3188719 1.8023392 -2.0865111 -1.628087 -0.0012640166"/>
    <key name="hand_down" qpos="0.86211118 -1.4205781 1.4896523 -1.6398706 -1.5707963 -0.0079838912" ctrl="0.86211118 -1.4205781 1.4896523 -1.6398706 -1.5707963 -0.0079838912"/>
    <key name="zero" qpos="0 0 0 0 0 0" ctrl="0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
