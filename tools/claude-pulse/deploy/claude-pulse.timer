# systemd *user* timer: fire claude-pulse-tick.service on a cadence.
# The policy engine decides whether each tick actually pokes, so a frequent
# tick is fine -- it just means finer-grained "poke as soon as idle enough".

[Unit]
Description=Run claude-pulse tick periodically

[Timer]
OnBootSec=5min
OnUnitActiveSec=10min
AccuracySec=1min
Persistent=true

[Install]
WantedBy=timers.target
