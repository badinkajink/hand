# systemd *user* service: run claude-pulse as a persistent daemon.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/claude-pulse.service ~/.config/systemd/user/
#   # edit ExecStart's path to your interpreter / entry point if needed
#   systemctl --user daemon-reload
#   systemctl --user enable --now claude-pulse
#   loginctl enable-linger "$USER"   # keep it running when logged out
#
# Logs: journalctl --user -u claude-pulse -f

[Unit]
Description=claude-pulse idle-usage monitor
After=network-online.target

[Service]
Type=simple
# Use the console entry point if installed (pip/uv), or `python -m claude_pulse run`.
ExecStart=%h/.local/bin/claude-pulse run --verbose
Restart=on-failure
RestartSec=30
# Uncomment to pin a config file:
# Environment=CLAUDE_PULSE_CONFIG=%h/.config/claude-pulse/config.toml

[Install]
WantedBy=default.target
