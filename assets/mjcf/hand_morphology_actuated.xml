<mujoco model="morphohand_hand">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient=".4 .4 .4" diffuse=".8 .8 .8" specular="0.1 0.1 0.1"/>
    <map znear=".01"/>
    <quality shadowsize="2048"/>
    <global elevation="-15"/>
  </visual>

  <default>
    <geom friction="1.0 0.05 0.001" solref="0.01 1" solimp="0.95 0.99 0.001"/>

    <!--
      MORPH class: x/y mount slides + phalange length slides.
      Actuated in this toy model so all 18 DoFs are user-drivable from MuJoCo viewer.
      Use lower gain and bounded force to keep morphology control responsive but stable.
    -->
    <default class="morph">
      <joint type="slide" damping="2000" armature="0.0001"/>
      <position kp="30" kv="0.5" gear="1" forcerange="-10 10" ctrlrange="-1 1"/>
    </default>

    <!--
      CTRL class: yaw/mcp/pip hinges, driven by position actuators.
      Joint default: hinge with light damping + armature for mass-matrix conditioning.
      Position actuator default:
        - kp=30  : stiffness. With finger chain I_eff~2e-4 kg·m², ωn=387 rad/s,
                   well within implicitfast stability.
        - kv=0.5 : velocity damping handled implicitly — critical for stability.
                   Total damping = joint damping (0.5) + kv (0.5) → heavily overdamped.
        - gear=1 : explicitly 1 so nothing is inherited/multiplied unexpectedly.
                   (gear on a position actuator scales the kp*error force output.)
        - forcerange: caps peak torque so large initial errors can't cause explosions.
        - ctrlrange: overridden per-actuator to match joint limits.
    -->
    <default class="ctrl">
      <joint type="hinge" damping="0.5" armature="0.001"/>
      <position kp="30" kv="0.5" gear="1" forcerange="-10 10" ctrlrange="-1 1"/>
    </default>

  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <texture name="grid" type="2d" builtin="checker" rgb1="0.15 0.15 0.15" rgb2="0.25 0.25 0.25" width="256" height="256"/>
    <material name="table_mat" texture="grid" texrepeat="3 3" reflectance="0.2"/>
    <material name="palm_mat" rgba="0.18 0.2 0.24 1"/>
    <material name="finger_mat" rgba="0.8 0.72 0.6 1"/>
    <material name="object_mat" rgba="0.18 0.5 0.9 1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="plane" size="1.5 1.5 0.1" material="table_mat"
          contype="0" conaffinity="0"/>

    <body gravcomp="1" name="palm" pos="0 0 0.15">
      <geom type="box" size="0.06 0.045 0.001" material="palm_mat"
            contype="0" conaffinity="0"/>

      <body gravcomp="1" name="thumb_mount" pos="-0.03 -0.028 0.0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint class="morph" name="thumb_x" axis="1 0 0" range="-0.03 0.03"/>
        <joint class="morph" name="thumb_y" axis="0 1 0" range="-0.03 0.03"/>
        <body gravcomp="1" name="thumb_yaw_frame">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint class="ctrl" name="thumb_yaw" axis="1 0 0" range="-1.1 1.1"/>
          <body gravcomp="1" name="thumb_mcp_frame">
            <joint class="ctrl" name="thumb_mcp" axis="0 1 0" range="0 3.14"/>
            <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.010" material="finger_mat"/>
            <body gravcomp="1" name="thumb_len_frame" pos="0.05 0 0">
              <joint class="morph" name="thumb_len" axis="1 0 0" range="0.0 0.035"/>
              <geom type="capsule" fromto="0 0 0 0.04 0 0" size="0.0085" material="finger_mat"/>
              <body gravcomp="1" name="thumb_pip_frame" pos="0.04 0 0">
                <joint class="ctrl" name="thumb_pip" axis="0 1 0" range="-1.2 0.5"/>
                <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0075" material="finger_mat"/>
                <body gravcomp="1" name="thumb_tip" pos="0.03 0 0">
                  <geom type="sphere" size="0.010" material="finger_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body gravcomp="1" name="index_mount" pos="0.00 0.03 0.0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint class="morph" name="index_x" axis="1 0 0" range="-0.03 0.03"/>
        <joint class="morph" name="index_y" axis="0 1 0" range="-0.03 0.03"/>
        <body gravcomp="1" name="index_yaw_frame">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint class="ctrl" name="index_yaw" axis="1 0 0" range="-1.1 1.1"/>
          <body gravcomp="1" name="index_mcp_frame">
            <joint class="ctrl" name="index_mcp" axis="0 1 0" range="0 2.5"/>
            <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.010" material="finger_mat"/>
            <body gravcomp="1" name="index_len_frame" pos="0.05 0 0">
              <joint class="morph" name="index_len" axis="1 0 0" range="0.0 0.035"/>
              <geom type="capsule" fromto="0 0 0 0.04 0 0" size="0.0085" material="finger_mat"/>
              <body gravcomp="1" name="index_pip_frame" pos="0.04 0 0">
                <joint class="ctrl" name="index_pip" axis="0 1 0" range="-1.2 1.57"/>
                <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0075" material="finger_mat"/>
                <body gravcomp="1" name="index_tip" pos="0.03 0 0">
                  <geom type="sphere" size="0.010" material="finger_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body gravcomp="1" name="middle_mount" pos="0.00 -0.03 0.0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint class="morph" name="middle_x" axis="1 0 0" range="-0.03 0.03"/>
        <joint class="morph" name="middle_y" axis="0 1 0" range="-0.03 0.03"/>
        <body gravcomp="1" name="middle_yaw_frame">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint class="ctrl" name="middle_yaw" axis="1 0 0" range="-1.1 1.1"/>
          <body gravcomp="1" name="middle_mcp_frame">
            <joint class="ctrl" name="middle_mcp" axis="0 1 0" range="0 2.5"/>
            <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.010" material="finger_mat"/>
            <body gravcomp="1" name="middle_len_frame" pos="0.05 0 0">
              <joint class="morph" name="middle_len" axis="1 0 0" range="0.0 0.035"/>
              <geom type="capsule" fromto="0 0 0 0.04 0 0" size="0.0085" material="finger_mat"/>
              <body gravcomp="1" name="middle_pip_frame" pos="0.04 0 0">
                <joint class="ctrl" name="middle_pip" axis="0 1 0" range="-1.2 1.57"/>
                <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0075" material="finger_mat"/>
                <body gravcomp="1" name="middle_tip" pos="0.03 0 0">
                  <geom type="sphere" size="0.010" material="finger_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- position actuators for the morphology joints: x, y, len, special for the _morphology_actuated.xml  -->
    <position class="morph" name="a_thumb_x" joint="thumb_x" ctrlrange="-0.03 0.03"/>
    <position class="morph" name="a_thumb_y" joint="thumb_y" ctrlrange="-0.03 0.03"/>
    <position class="morph" name="a_index_x" joint="index_x" ctrlrange="-0.03 0.03"/>
    <position class="morph" name="a_index_y" joint="index_y" ctrlrange="-0.03 0.03"/>
    <position class="morph" name="a_middle_x" joint="middle_x" ctrlrange="-0.03 0.03"/>
    <position class="morph" name="a_middle_y" joint="middle_y" ctrlrange="-0.03 0.03"/>
    <position class="morph" name="a_thumb_len" joint="thumb_len" ctrlrange="0.0 0.035"/>
    <position class="morph" name="a_index_len" joint="index_len" ctrlrange="0.0 0.035"/>
    <position class="morph" name="a_middle_len" joint="middle_len" ctrlrange="0.0 0.035"/>

    <!-- Position actuators: ctrl = target joint angle in radians.
         ctrlrange matches each joint's range exactly.
         gear=1 (from class default) — not multiplied. -->
    <position class="ctrl" name="a_thumb_yaw" joint="thumb_yaw" ctrlrange="-1.1 1.1"/>
    <position class="ctrl" name="a_thumb_mcp" joint="thumb_mcp" ctrlrange="0 3.14"/>
    <position class="ctrl" name="a_thumb_pip" joint="thumb_pip" ctrlrange="-1.2 0.5"/>

    <position class="ctrl" name="a_index_yaw" joint="index_yaw" ctrlrange="-1.1 1.1"/>
    <position class="ctrl" name="a_index_mcp" joint="index_mcp" ctrlrange="0 2.5"/>
    <position class="ctrl" name="a_index_pip" joint="index_pip" ctrlrange="-1.2 1.57"/>

    <position class="ctrl" name="a_middle_yaw" joint="middle_yaw" ctrlrange="-1.1 1.1"/>
    <position class="ctrl" name="a_middle_mcp" joint="middle_mcp" ctrlrange="0 2.5"/>
    <position class="ctrl" name="a_middle_pip" joint="middle_pip" ctrlrange="-1.2 1.57"/>
  </actuator>

  <keyframe>
    <!-- qpos order (18 values):
         thumb:  x  y | yaw  mcp  len  pip
         index:  x  y | yaw  mcp  len  pip
         middle: x  y | yaw  mcp  len  pip

        ctrl order (18 values):
          [thumb_x thumb_y index_x index_y middle_x middle_y thumb_len index_len middle_len]
          [thumb_yaw thumb_mcp thumb_pip index_yaw index_mcp index_pip middle_yaw middle_mcp middle_pip]
        Must match qpos values for all actuated joints so reset/home starts at zero error.
    -->
    <key name="open"
      qpos="
        0     0.02
              0
              2
              0
              -0.707
        0.01  -0.0123
              0
              1.25
              0
              1
        0.01  0.0153
              0
              1.25
              0
              1
      "
      ctrl="
        0  0.02  0.01  -0.0123  0.01  0.0153  0  0  0
        0  2  -0.707
        0  1.25  1
        0  1.25  1
      "/>
  </keyframe>

</mujoco>