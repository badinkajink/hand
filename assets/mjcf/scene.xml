<mujoco model="morphohand_scene">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <visual>
    <headlight ambient=".4 .4 .4" diffuse=".8 .8 .8" specular="0.1 0.1 0.1"/>
    <map znear=".01"/>
    <quality shadowsize="2048"/>
    <global elevation="-15"/>
  </visual>

  <default>
    <joint damping="0.5"/>
    <geom friction="1.0 0.05 0.001" solref="0.004 1" solimp="0.95 0.99 0.001"/>
    <motor ctrlrange="-1 1" ctrllimited="true"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <texture name="grid" type="2d" builtin="checker" rgb1="0.15 0.15 0.15" rgb2="0.25 0.25 0.25" width="256" height="256"/>
    <material name="table_mat" texture="grid" texrepeat="3 3" reflectance="0.2"/>
    <material name="palm_mat" rgba="0.18 0.2 0.24 1"/>
    <material name="finger_mat" rgba="0.8 0.72 0.6 1"/>
    <material name="object_mat" rgba="0.18 0.5 0.9 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" diffuse=".6 .6 .6" specular=".2 .2 .2"/>
    <light pos="0.5 0.5 1.0" dir="-1 -1 -1" directional="true" diffuse=".4 .4 .4" specular=".1 .1 .1"/>
    <geom name="floor" type="plane" size="1.5 1.5 0.1" material="groundplane"/>

    <!-- box rests directly on floor; half-size=0.02 so centre at z=0.02 -->
    <body name="cube" pos="0.0 0.0 0.02">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" density="500" material="object_mat"/>
    </body>

    <body name="palm_pose" pos="0 0 -0.15">
      <joint name="palm_px" type="slide" axis="1 0 0" range="-0.20 0.20"/>
      <joint name="palm_py" type="slide" axis="0 1 0" range="-0.20 0.20"/>
      <joint name="palm_pz" type="slide" axis="0 0 1" range="-0.15 0.35"/>
      <joint name="palm_rx" type="hinge" axis="1 0 0" range="-1.57 1.57"/>
      <joint name="palm_ry" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
      <joint name="palm_rz" type="hinge" axis="0 0 1" range="-3.14 3.14"/>

      <geom type="box" size="0.06 0.045 0.001" material="palm_mat"/>

      <body name="thumb_mount" pos="-0.03 -0.028 0.0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="thumb_x" type="slide" axis="1 0 0" range="-0.03 0.03"/>
        <joint name="thumb_y" type="slide" axis="0 1 0" range="-0.03 0.03"/>
        <body name="thumb_yaw_frame">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="thumb_yaw" type="hinge" axis="1 0 0" range="-1.1 1.1"/>
          <body name="thumb_mcp_frame">
            <joint name="thumb_mcp" type="hinge" axis="0 1 0" range="0 3.14"/>
            <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.010" material="finger_mat"/>
            <body name="thumb_len_frame" pos="0.05 0 0">
              <joint name="thumb_len" type="slide" axis="1 0 0" range="0.0 0.035"/>
              <geom type="capsule" fromto="0 0 0 0.04 0 0" size="0.0085" material="finger_mat"/>
              <body name="thumb_pip_frame" pos="0.04 0 0">
                <joint name="thumb_pip" type="hinge" axis="0 1 0" range="-1.2 0.5"/>
                <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0075" material="finger_mat"/>
                <body name="thumb_tip" pos="0.03 0 0">
                  <geom type="sphere" size="0.010" material="finger_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body name="index_mount" pos="0.00 0.03 0.0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="index_x" type="slide" axis="1 0 0" range="-0.03 0.03"/>
        <joint name="index_y" type="slide" axis="0 1 0" range="-0.03 0.03"/>
        <body name="index_yaw_frame">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="index_yaw" type="hinge" axis="1 0 0" range="-1.1 1.1"/>
          <body name="index_mcp_frame">
            <joint name="index_mcp" type="hinge" axis="0 1 0" range="0 2.5"/>
            <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.010" material="finger_mat"/>
            <body name="index_len_frame" pos="0.05 0 0">
              <joint name="index_len" type="slide" axis="1 0 0" range="0.0 0.035"/>
              <geom type="capsule" fromto="0 0 0 0.04 0 0" size="0.0085" material="finger_mat"/>
              <body name="index_pip_frame" pos="0.04 0 0">
                <joint name="index_pip" type="hinge" axis="0 1 0" range="-1.2 1.57"/>
                <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0075" material="finger_mat"/>
                <body name="index_tip" pos="0.03 0 0">
                  <geom type="sphere" size="0.010" material="finger_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body name="middle_mount" pos="0.00 -0.03 0.0">
        <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
        <joint name="middle_x" type="slide" axis="1 0 0" range="-0.03 0.03"/>
        <joint name="middle_y" type="slide" axis="0 1 0" range="-0.03 0.03"/>
        <body name="middle_yaw_frame">
          <inertial pos="0 0 0" mass="0.001" diaginertia="1e-6 1e-6 1e-6"/>
          <joint name="middle_yaw" type="hinge" axis="1 0 0" range="-1.1 1.1"/>
          <body name="middle_mcp_frame">
            <joint name="middle_mcp" type="hinge" axis="0 1 0" range="0 2.5"/>
            <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.010" material="finger_mat"/>
            <body name="middle_len_frame" pos="0.05 0 0">
              <joint name="middle_len" type="slide" axis="1 0 0" range="0.0 0.035"/>
              <geom type="capsule" fromto="0 0 0 0.04 0 0" size="0.0085" material="finger_mat"/>
              <body name="middle_pip_frame" pos="0.04 0 0">
                <joint name="middle_pip" type="hinge" axis="0 1 0" range="-1.2 1.57"/>
                <geom type="capsule" fromto="0 0 0 0.03 0 0" size="0.0075" material="finger_mat"/>
                <body name="middle_tip" pos="0.03 0 0">
                  <geom type="sphere" size="0.010" material="finger_mat"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="a_palm_px" joint="palm_px" gear="100"/>
    <motor name="a_palm_py" joint="palm_py" gear="100"/>
    <motor name="a_palm_pz" joint="palm_pz" gear="100"/>
    <motor name="a_palm_rx" joint="palm_rx" gear="20"/>
    <motor name="a_palm_ry" joint="palm_ry" gear="20"/>
    <motor name="a_palm_rz" joint="palm_rz" gear="20"/>

    <motor name="a_thumb_x" joint="thumb_x" gear="60"/>
    <motor name="a_thumb_y" joint="thumb_y" gear="60"/>
    <motor name="a_thumb_yaw" joint="thumb_yaw" gear="25"/>
    <motor name="a_thumb_mcp" joint="thumb_mcp" gear="20"/>
    <motor name="a_thumb_len" joint="thumb_len" gear="40"/>
    <motor name="a_thumb_pip" joint="thumb_pip" gear="20"/>

    <motor name="a_index_x" joint="index_x" gear="60"/>
    <motor name="a_index_y" joint="index_y" gear="60"/>
    <motor name="a_index_yaw" joint="index_yaw" gear="25"/>
    <motor name="a_index_mcp" joint="index_mcp" gear="20"/>
    <motor name="a_index_len" joint="index_len" gear="40"/>
    <motor name="a_index_pip" joint="index_pip" gear="20"/>

    <motor name="a_middle_x" joint="middle_x" gear="60"/>
    <motor name="a_middle_y" joint="middle_y" gear="60"/>
    <motor name="a_middle_yaw" joint="middle_yaw" gear="25"/>
    <motor name="a_middle_mcp" joint="middle_mcp" gear="20"/>
    <motor name="a_middle_len" joint="middle_len" gear="40"/>
    <motor name="a_middle_pip" joint="middle_pip" gear="20"/>
  </actuator>

  <keyframe>
    <!-- qpos ordering (31 values total):
         [0-6]   cube freejoint:  px py pz  qw qx qy qz
         [7-12]  palm 6DOF:       px py pz  rx ry rz
         [13-14] thumb_mount:     tx ty
         [15]    thumb_yaw
         [16]    thumb_mcp
         [17]    thumb_len
         [18]    thumb_pip
         [19-20] index_mount:     ix iy
         [21]    index_yaw
         [22]    index_mcp
         [23]    index_len
         [24]    index_pip
         [25-26] middle_mount:    mx my
         [27]    middle_yaw
         [28]    middle_mcp
         [29]    middle_len
         [30]    middle_pip
    -->
    <key name="open"
      qpos="
        0 0 0.02  1 0 0 0
        0.02 0 0  0 0 0
        0 0.02
            0
            2
            0
            -0.707
        0.01 -0.0123
            0
            1.25
            0
            1
        0.01 0.0153
            0
            1.25
            0
            1
        "/>
    </keyframe>

</mujoco>